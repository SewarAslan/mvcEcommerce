@using Ecommerce.ViewModels
@model List<ProductViewModel>

@{
    ViewData["Title"] = "Products";
}


<section class="store-page-header">

    <div class="container px-4 px-lg-5">

        <span class="page-badge">
            <i class="bi bi-box-seam"></i>
            Products
        </span>

        <h1>@ViewBag.CategoryName</h1>

        <p>
            Browse products available in this category.
        </p>

    </div>

</section>


<section class="store-section">

    <div class="container px-4 px-lg-5">


        <div class="d-flex justify-content-between
                    align-items-end flex-wrap gap-3
                    section-header">

            <div>

                <h2 class="section-title">
                    Products
                </h2>

                <p class="section-description">
                    @Model.Count product(s) available
                </p>

            </div>


            <a asp-area="User"
               asp-controller="Home"
               asp-action="Index"
               class="btn btn-store-outline">

                <i class="bi bi-arrow-left me-1"></i>

                Back to Categories

            </a>

        </div>


        @if (!Model.Any())
        {
            <div class="empty-state text-center">

                <div class="category-icon mx-auto mb-3">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h5>No products available</h5>

                <p class="text-muted">
                    This category doesn't have any products yet.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var product in Model)
                {
                    <div class="col-xl-4 col-lg-4 col-md-6">

                        <div class="product-card">


                            <div class="product-image-wrapper">

                                <img src="~/images/products/@product.MainImage"
                                     alt="@product.Name"
                                     class="product-image" />

                            </div>


                            <div class="product-card-body">

                                <div class="product-category">
                                    @product.CategoryName
                                </div>


                                <h5 class="product-name">
                                    @product.Name
                                </h5>


                                <div class="product-bottom">

                                    <span class="product-price">
                                        $@product.Price
                                    </span>


                                    @if (product.Quantity > 0)
                                    {
                                        <span class="stock available">

                                            <i class="bi bi-check-circle me-1"></i>

                                            In Stock

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock unavailable">
                                            Out of Stock
                                        </span>
                                    }

                                </div>


                                <a asp-area="User"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-store w-100">

                                    View Details

                                    <i class="bi bi-arrow-right ms-1"></i>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</section>