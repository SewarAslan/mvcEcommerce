@using Ecommerce.ViewModels
@model ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}


<section class="store-section">

    <div class="container px-4 px-lg-5">

        <div class="product-details-card">

            <div class="row g-5 align-items-center">


                <!-- Image -->
                <div class="col-lg-6">

                    <img src="~/images/products/@Model.MainImage"
                         alt="@Model.Name"
                         class="product-details-image" />

                </div>


                <!-- Details -->
                <div class="col-lg-6">


                    <span class="product-category-badge mb-3">

                        <i class="bi bi-tag me-1"></i>

                        @Model.CategoryName

                    </span>


                    <h1 class="fw-bold mb-3">
                        @Model.Name
                    </h1>


                    <div class="store-price fs-3 mb-4">
                        $@Model.Price
                    </div>


                    <p class="text-muted fs-5 mb-4">
                        @Model.Description
                    </p>


                    <hr />


                    <div class="row my-4">


                        <div class="col-sm-6 mb-3">

                            <small class="text-muted d-block">
                                Rating
                            </small>

                            <strong>

                                <i class="bi bi-star-fill"></i>

                                @Model.Rate / 5

                            </strong>

                        </div>


                        <div class="col-sm-6 mb-3">

                            <small class="text-muted d-block">
                                Availability
                            </small>


                            @if (Model.Quantity > 0)
                            {
                                <span class="stock-success">

                                    <i class="bi bi-check-circle-fill me-1"></i>

                                    In Stock
                                    (@Model.Quantity available)

                                </span>
                            }
                            else
                            {
                                <span class="stock-danger">

                                    <i class="bi bi-x-circle-fill me-1"></i>

                                    Out of Stock

                                </span>
                            }

                        </div>


                    </div>


                    <div class="d-flex gap-2 flex-wrap">

                        <a asp-area="User"
                           asp-controller="Products"
                           asp-action="Index"
                           asp-route-categoryId="@Model.CategoryId"
                           class="btn btn-store-outline">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back to Products

                        </a>


                        @if (Model.Quantity > 0)
                        {
                            <button class="btn btn-store">

                                <i class="bi bi-cart-plus me-1"></i>

                                Add to Cart

                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>