@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<style>
    .app-sidebar {
        background: #20242b !important;
        border-right: 1px solid #2f343d;
    }

    .sidebar-brand {
        height: 70px;
        border-bottom: 1px solid #343941;
        display: flex;
        align-items: center;
        padding: 0 18px;
    }

    .brand-link {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #ffffff !important;
        width: 100%;
    }

    .brand-logo {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #635bdb;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
        flex-shrink: 0;
    }

    .brand-text {
        font-size: 16px;
        font-weight: 600;
        white-space: nowrap;
    }

    .sidebar-menu {
        padding: 0 10px;
    }

    .sidebar-menu .nav-header {
        color: #8b919a;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .8px;
        padding: 18px 12px 8px;
    }

    .sidebar-menu .nav-link {
        border-radius: 9px;
        margin-bottom: 4px;
        color: #c7cbd1;
        padding: 10px 12px;
        transition: all .2s ease;
    }

    .sidebar-menu .nav-link:hover {
        background: #2d323a;
        color: #ffffff;
    }

    .sidebar-menu .nav-link.active {
        background: #635bdb;
        color: #ffffff;
    }

    .sidebar-menu .nav-icon {
        font-size: 16px;
        margin-right: 8px;
    }

    .nav-treeview {
        padding-left: 10px;
    }

    .nav-treeview .nav-link {
        font-size: 14px;
        padding-left: 18px;
    }

    .nav-treeview .nav-link.active {
        background: rgba(99, 91, 219, 0.18);
        color: #a9a4ff;
    }

    .nav-treeview .nav-link.active .nav-icon {
        color: #8179ee;
    }
</style>


<aside class="app-sidebar shadow"
       data-bs-theme="dark">

    <!-- Brand -->
    <div class="sidebar-brand">

        <a asp-area="Admin"
           asp-controller="Home"
           asp-action="Index"
           class="brand-link text-decoration-none">

            <div class="brand-logo">
                <i class="bi bi-bag"></i>
            </div>

            <span class="brand-text">
                Ecommerce Admin
            </span>

        </a>

    </div>


    <!-- Sidebar -->
    <div class="sidebar-wrapper">

        <nav class="mt-2">

            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                data-accordion="false">

                <!-- Main -->
                <li class="nav-header">
                    MAIN MENU
                </li>


                <!-- Dashboard -->
                <li class="nav-item">

                    <a asp-area="Admin"
                       asp-controller="Home"
                       asp-action="Index"
                       class="nav-link @(controller == "Home" ? "active" : "")">

                        <i class="nav-icon bi bi-grid"></i>

                        <p>
                            Dashboard
                        </p>

                    </a>

                </li>


                <!-- Management -->
                <li class="nav-header">
                    MANAGEMENT
                </li>


                <!-- Categories -->
                <li class="nav-item @(controller == "Categories" ? "menu-open" : "")">

                    <a href="#"
                       class="nav-link @(controller == "Categories" ? "active" : "")">

                        <i class="nav-icon bi bi-tags"></i>

                        <p>
                            Categories
                            <i class="nav-arrow bi bi-chevron-right"></i>
                        </p>

                    </a>


                    <ul class="nav nav-treeview">

                        <!-- All Categories -->
                        <li class="nav-item">

                            <a asp-area="Admin"
                               asp-controller="Categories"
                               asp-action="Index"
                               class="nav-link @(controller == "Categories" && action == "Index" ? "active" : "")">

                                <i class="nav-icon bi bi-list-ul"></i>

                                <p>
                                    All Categories
                                </p>

                            </a>

                        </li>




                    </ul>

                </li>
                                           <!-- Categories -->
                <li class="nav-item @(controller == "Categories" ? "menu-open" : "")">

                    <a href="#"
                       class="nav-link @(controller == "Categories" ? "active" : "")">

                        <i class="nav-icon bi bi-tags"></i>

                        <p>
                           Products
                            <i class="nav-arrow bi bi-chevron-right"></i>
                        </p>

                    </a>


                    <ul class="nav nav-treeview">

                        <!-- All Products -->
                        <li class="nav-item">

                            <a asp-area="Admin"
                               asp-controller="Products"
                               asp-action="Index"
                               class="nav-link @(controller == "Products" && action == "Index" ? "active" : "")">

                                <i class="nav-icon bi bi-list-ul"></i>

                                <p>
                                    All Products
                                </p>

                            </a>

                        </li>
            </ul>

        </nav>

    </div>

</aside>