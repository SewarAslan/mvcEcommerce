@using Ecommerce.ViewModels
@model List<ProductViewModel>

@{
    ViewData["Title"] = "Products";
}

<div class="card categories-card">

    <div class="categories-header">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex align-items-center gap-3">

                <div class="admin-heading-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <h3 class="categories-title">
                        Products
                    </h3>

                    <p class="categories-subtitle">
                        Manage your store products
                    </p>
                </div>

            </div>

            <a asp-area="Admin"
               asp-controller="Products"
               asp-action="Create"
               class="btn btn-add-category">

                <i class="bi bi-plus-lg me-1"></i>
                Add Product

            </a>

        </div>

    </div>


@if (!Model.Any())
{
    <div class="empty-products-state text-center">

        <div class="empty-products-icon">
            <i class="bi bi-box-seam"></i>
        </div>

        <h4 class="fw-bold mt-3 mb-2">
            No Products Yet
        </h4>

        <p class="text-muted mb-4">
            Your product list is currently empty. Start by adding your first product.
        </p>

        <a asp-controller="Products"
           asp-action="Create"
           class="btn btn-add-category">

            <i class="bi bi-plus-lg me-1"></i>
            Add First Product

        </a>

    </div>
}
    else
    {
        <div class="table-responsive">

<table class="table categories-table align-middle">

    <thead>
        <tr>
            <th style="width: 70px;">ID</th>
            <th>Image</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Status</th>

            <th class="text-end" style="width: 140px;">
                Actions
            </th>
        </tr>
    </thead>


    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <!-- ID -->
                <td>
                    <span class="admin-id">
                        #@item.Id
                    </span>
                </td>


                <!-- Image -->
                <td>
                    <img src="~/images/products/@item.MainImage"
                         alt="@item.Name"
                         width="70"
                         height="70"
                         style="object-fit: cover; border-radius: 8px;" />
                </td>


                <!-- Name -->
                <td>
                    <span class="admin-name">
                        @item.Name
                    </span>
                </td>


                <!-- Category -->
                <td>
                    @item.CategoryName
                </td>


                <!-- Price -->
                <td>
                    $@item.Price
                </td>


                <!-- Quantity -->
                <td>
                    @item.Quantity
                </td>


                <!-- Status -->
                <td>

                    @if (item.Status == Ecommerce.Eunums.Status.Active)
                    {
                        <span class="status status-active">
                            <i class="bi bi-check-circle-fill"></i>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="status status-inactive">
                            <i class="bi bi-x-circle-fill"></i>
                            Inactive
                        </span>
                    }

                </td>


                <!-- Actions -->
                <td class="text-end">

                    <a asp-controller="Products"
                       asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-primary action-button me-1"
                       title="Edit">

                        <i class="bi bi-pencil"></i>

                    </a>


                    <a asp-controller="Products"
                       asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-outline-danger action-button"
                       title="Delete"
                       onclick="return confirm('Are you sure you want to delete this product?')">

                        <i class="bi bi-trash"></i>

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>

        </div>
    }

</div>
