@using Ecommerce.ViewModels
@model EditProductViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">

    <div class="col-lg-8 col-xl-7">

        <div class="card form-card">

            <!-- Header -->
            <div class="form-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="form-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                    <div>
                        <h3 class="form-title">
                            Edit Product
                        </h3>

                        <p class="form-subtitle">
                            Update product information and availability
                        </p>
                    </div>

                </div>

            </div>


         <form asp-controller="Products"
      asp-action="Update"
      method="post"
      enctype="multipart/form-data">

               <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CurrentImage" />


                <div class="card-body p-4">

                    <!-- Product Name -->
                    <div class="mb-4">

                        <label asp-for="Name"
                               class="form-label custom-label">
                            Product Name
                        </label>

                        <input asp-for="Name"
                               class="form-control custom-input"
                               placeholder="Enter product name" />

                        <span asp-validation-for="Name"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>


                    <!-- Description -->
                    <div class="mb-4">

                        <label asp-for="Description"
                               class="form-label custom-label">
                            Product Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control custom-input"
                                  rows="4"
                                  placeholder="Enter product description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>


                    <!-- Price & Quantity -->
                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label asp-for="Price"
                                   class="form-label custom-label">
                                Product Price
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    $
                                </span>

                                <input asp-for="Price"
                                       class="form-control custom-input"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger small mt-1 d-block">
                            </span>

                        </div>


                        <div class="col-md-6 mb-4">

                            <label asp-for="Quantity"
                                   class="form-label custom-label">
                                Quantity
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control custom-input"
                                   placeholder="Enter quantity" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger small mt-1 d-block">
                            </span>

                        </div>

                    </div>


                    <!-- Rate & Status -->
                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label asp-for="Rate"
                                   class="form-label custom-label">
                                Rate
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-star"></i>
                                </span>

                                <input asp-for="Rate"
                                       class="form-control custom-input"
                                       placeholder="0.0" />

                            </div>

                            <span asp-validation-for="Rate"
                                  class="text-danger small mt-1 d-block">
                            </span>

                        </div>


                        <div class="col-md-6 mb-4">

                            <label asp-for="Status"
                                   class="form-label custom-label">
                                Status
                            </label>

                            <select asp-for="Status"
                                    class="form-select custom-select">

                                <option value="Active">
                                    Active
                                </option>

                                <option value="InActive">
                                    Inactive
                                </option>

                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger small mt-1 d-block">
                            </span>

                        </div>

                    </div>


                    <!-- Category -->
                    <div class="mb-2">

                        <label asp-for="CategoryId"
                               class="form-label custom-label">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select custom-select">

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger small mt-1 d-block">
                        </span>

                        <small class="text-muted d-block mt-2">
                            Select the category this product belongs to.
                        </small>

                    </div>
                    <div class="mb-4">

    <label class="form-label custom-label">
        Current Image
    </label>

    @if (!string.IsNullOrEmpty(Model.CurrentImage))
    {
        <div class="mb-3">
            <img src="~/images/products/@Model.CurrentImage"
                 width="150"
                 class="rounded border" />
        </div>
    }

    <label asp-for="MainImage"
           class="form-label custom-label">
        Change Product Image
    </label>

    <input asp-for="MainImage"
           type="file"
           accept="image/*"
           class="form-control custom-input" />

    <small class="text-muted">
        Leave empty to keep the current image.
    </small>

</div>

                </div>


                <!-- Footer -->
                <div class="form-footer d-flex justify-content-between align-items-center">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-cancel">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Products

                    </a>


                    <button type="submit"
                            class="btn btn-save">

                        <i class="bi bi-check-lg me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}