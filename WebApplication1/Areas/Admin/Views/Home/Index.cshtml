@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome -->
<div class="dashboard-welcome mb-4">

    <div>
        <span class="dashboard-welcome-badge">
            Admin Panel
        </span>

        <h2 class="dashboard-welcome-title">
            Welcome to Ecommerce Admin
        </h2>

        <p class="dashboard-welcome-text">
            Manage your store categories and products from one place.
        </p>
    </div>

    <div class="dashboard-welcome-icon">
        <i class="bi bi-bag-check"></i>
    </div>

</div>


<div class="row g-4">

    <!-- Categories -->
    <div class="col-lg-6">

        <div class="dashboard-management-card">

            <div class="dashboard-card-top">

                <div class="dashboard-module-icon">
                    <i class="bi bi-tags"></i>
                </div>

                <span class="dashboard-module-label">
                    Store Management
                </span>

            </div>


            <div class="dashboard-card-content">

                <h3>
                    Categories
                </h3>

                <p>
                    Organize your products into clear and manageable categories.
                </p>

            </div>


            <div class="dashboard-card-actions">

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="dashboard-main-action">

                    View Categories
                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Categories"
                   asp-action="Create"
                   class="dashboard-secondary-action">

                    <i class="bi bi-plus-lg"></i>
                    Add New

                </a>

            </div>

        </div>

    </div>


    <!-- Products -->
    <div class="col-lg-6">

        <div class="dashboard-management-card">

            <div class="dashboard-card-top">

                <div class="dashboard-module-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <span class="dashboard-module-label">
                    Store Management
                </span>

            </div>


            <div class="dashboard-card-content">

                <h3>
                    Products
                </h3>

                <p>
                    Add, edit and manage all products available in your store.
                </p>

            </div>


            <div class="dashboard-card-actions">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="dashboard-main-action">

                    View Products
                    <i class="bi bi-arrow-right"></i>

                </a>

                <a asp-controller="Products"
                   asp-action="Create"
                   class="dashboard-secondary-action">

                    <i class="bi bi-plus-lg"></i>
                    Add New

                </a>

            </div>

        </div>

    </div>

</div>